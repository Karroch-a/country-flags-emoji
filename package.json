{
  "name": "@karroch/country-flags-emoji",
  "version": "2.0.0",
  "description": "Convert ISO 3166-1 country codes to flag emojis",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "flag",
    "flags",
    "emoji",
    "country",
    "country-code",
    "ISO-3166",
    "ISO-3166-1",
    "conversion",
    "typescript"
  ],
  "author": "Karroch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karroch-a/country-flags-emoji.git"
  },
  "bugs": {
    "url": "https://github.com/Karroch-a/country-flags-emoji/issues"
  },
  "homepage": "https://github.com/Karroch-a/country-flags-emoji#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
